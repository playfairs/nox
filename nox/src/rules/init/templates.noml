ruleset "templates" {
    template: rust_manifest {
        optional: true
        path: "Cargo.toml"
        languages: ["Rust"]
    },
    template: javascript_manifest {
        optional: true
        path: "package.json"
        languages: ["JavaScript", "TypeScript"]
    },
    template: typescript_config {
        optional: true
        path: "tsconfig.json"
        languages: ["TypeScript"]
    },
    template: swift_manifest {
        optional: true
        path: "Package.swift"
        languages: ["Swift"]
    },
    template: python_manifest {
        optional: true
        path: "pyproject.toml"
        languages: ["Python"]
    },
    template: noxfile {
        optional: true
        path: noxfile
        languages: []
    },
    template: flake {
        optional: true
        path: "flake.nix"
        languages: []
    },
    template: readme {
        optional: true
        path: "README.md"
        languages: []
    },
    template: gitignore {
        optional: true
        path: ".gitignore"
        languages: []
    }
}