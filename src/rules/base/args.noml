ruleset "arguments" {
    argument: help {
        repeatable: false
        takes_value: false
    },
    argument: version {
        repeatable: false
        takes_value: false
    },
    argument: jobs {
        repeatable: false
        takes_value: true
    },
    argument: build-dir {
        repeatable: false
        takes_value: true
    },
    argument: compile-flag {
        repeatable: true
        takes_value: true
    },
    argument: prefix {
        repeatable: false
        takes_value: true
    },
    argument: release {
        repeatable: false
        takes_value: false
    },
    argument: debug {
        repeatable: false
        takes_value: false
    },
    argument: reconfigure {
        repeatable: false
        takes_value: false
    }
}