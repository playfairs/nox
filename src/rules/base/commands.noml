ruleset "commands" {
    command: help {
        aliases: []
        description: ["Display help information."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: false
        }
    },
    command: version {
        aliases: []
        description: ["Display the current version."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: false
        }
    },
    command: riders {
        aliases: []
        description: ["Display available riders."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: false
        }
    },
    command: init {
        aliases: []
        description: ["Initialize a new project."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: false
        }
    },
    command: setup {
        aliases: ["configure"]
        description: ["Configure the current project."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: build {
        aliases: ["compile", "b"]
        description: ["Build the current project."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: true
            requires_project: true
        }
    },
    command: rebuild {
        aliases: []
        description: ["Clean and rebuild the current project."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: clean {
        aliases: []
        description: ["Clean project build artifacts."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: doctor {
        aliases: ["doc"]
        description: ["Diagnose the project setup and build state."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: install {
        aliases: ["i"]
        description: ["Install the current project."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: uninstall {
        aliases: []
        description: ["Uninstall the current project."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: validate {
        aliases: []
        description: ["Validate the current project."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: env {
        aliases: []
        description: ["Display the active environment for the current project."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: status {
        aliases: ["stat"]
        description: ["Display the current project status."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: targets {
        aliases: ["list"]
        description: ["List available project targets."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: graph {
        aliases: []
        description: ["Display the project dependency graph."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: run {
        aliases: ["r"]
        description: ["Run the current project, a named executable target, or a source file."]
        rules: {
            accepts_files_as_input: true
            requires_initialization: true
            requires_project: true
        }
    },
    command: nomlfmt {
        aliases: []
        description: ["Format one NOML file or every NOML file in a directory."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: false
        }
    },
    command: test {
        aliases: []
        description: ["Run the project's tests."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: true
            requires_project: true
        }
    },
    command: task {
        aliases: []
        description: ["Run a named project task."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: tasks {
        aliases: []
        description: ["List available project tasks."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    },
    command: bump-version {
        aliases: ["bump"]
        description: ["Bump the project version."]
        rules: {
            accepts_files_as_input: false
            requires_initialization: false
            requires_project: true
        }
    }
}