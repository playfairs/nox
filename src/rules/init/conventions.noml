ruleset "conventions" {
    convention: test_directories {
        priority: 100
        role: directory
        values: ["test", "tests", "spec", "__tests__"]
    },
    convention: main_files {
        priority: 100
        role: stem
        values: ["main", "Main", "index", "Program", "__main__"]
    },
    convention: source_directories {
        priority: 100
        role: directory
        values: ["src", "source", "app", "lib"]
    },
    convention: include_directories {
        priority: 100
        role: directory
        values: ["include", "includes", "inc", "headers", "public"]
    },
    convention: example_directories {
        priority: 80
        role: directory
        values: ["example", "examples"]
    }
}