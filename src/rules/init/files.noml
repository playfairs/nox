ruleset "files" {
    file: "Cargo.toml" {
        languages: [Rust]
        build_system: "Cargo"
        project_name: "toml_name"
        project_type: null
    },

    file: "Package.swift" {
        languages: [Swift]
        build_system: "SwiftPM"
        project_name: null
        project_type: null
    },

    file: "package.json" {
        languages: [JavaScript]
        build_system: "npm"
        project_name: "json_name"
        project_type: null
    },

    file: "tsconfig.json" {
        languages: [TypeScript]
        build_system: null
        project_name: null
        project_type: null
    },

    file: "pyproject.toml" {
