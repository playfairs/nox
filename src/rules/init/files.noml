ruleset "files" {
    file: "Cargo.toml" {
        build_system: Cargo
        project_name: toml_name
        project_type: null
        languages: ["Rust"]
    },
    file: "Package.swift" {
        build_system: SwiftPM
        project_name: null
        project_type: null
        languages: ["Swift"]
    },
    file: "package.json" {
        build_system: npm
        project_name: json_name
        project_type: null
        languages: ["JavaScript"]
    },
    file: "tsconfig.json" {
        build_system: null
        project_name: null
        project_type: null
        languages: ["TypeScript"]
    },
    file: "pyproject.toml" {
        build_system: pyproject
        project_name: null
        project_type: null
        languages: ["Python"]
    },
    file: "CMakeLists.txt" {
        build_system: CMake
        project_name: null
        project_type: null
        languages: []
    },
    file: "meson.build" {
        build_system: Meson
        project_name: null
        project_type: null
        languages: []
    },
    file: Makefile {
        build_system: Make
        project_name: null
        project_type: null
        languages: []
    },
    file: Justfile {
        build_system: Just
        project_name: null
        project_type: null
        languages: []
    },
    file: "build.zig" {
        build_system: Zig
        project_name: null
        project_type: null
        languages: []
    },
    file: "go.mod" {
        build_system: Go
        project_name: null
        project_type: null
        languages: []
    },
    file: "flake.nix" {
        build_system: Nix
        project_name: null
        project_type: null
        languages: []
    },
    file: "rustfmt.toml" {
        build_system: null
        project_name: null
        project_type: null
        languages: []
    },
    file: ".clang-format" {
        build_system: null
        project_name: null
        project_type: null
        languages: []
    },
    file: ".prettierrc" {
        build_system: null
        project_name: null
        project_type: null
        languages: []
    },
    file: ".prettierrc.json" {
        build_system: null
        project_name: null
        project_type: null
        languages: []
    },
    file: ".swift-format" {
        build_system: null
        project_name: null
        project_type: null
        languages: []
    }
}