ruleset "languages" {
    language: Rust {
        aliases: ["rust"]
        display_name: Rust
        extensions: ["rs"]
        header_extensions: []
        main_files: ["main.rs"]
        related_files: ["Cargo.toml"]
        target_types: ["executable", "rust_library"]
    },
    language: Haskell {
        aliases: ["haskell", "hs"]
        display_name: Haskell
        extensions: ["hs", "lhs"]
        header_extensions: []
        main_files: ["Main.hs", "main.hs"]
        related_files: []
        target_types: ["executable"]
    },
    language: C {
        aliases: ["c"]
        display_name: C
        extensions: ["c"]
        header_extensions: ["h"]
        main_files: ["main.c"]
        related_files: []
        target_types: ["executable", "static_library", "shared_library"]
    },
    language: Cpp {
        aliases: ["cpp", "c++", "cxx"]
        display_name: "C++"
        extensions: ["cc", "cpp", "cxx"]
        header_extensions: ["hh", "hpp", "hxx"]
        main_files: ["main.cpp", "main.cc", "main.cxx"]
        related_files: []
        target_types: ["executable", "static_library", "shared_library"]
    },
    language: D {
        aliases: ["d"]
        display_name: D
        extensions: ["d"]
        header_extensions: []
        main_files: ["main.d"]
        related_files: []
        target_types: ["executable"]
    },
    language: Swift {
        aliases: ["swift"]
        display_name: Swift
        extensions: ["swift"]
        header_extensions: []
        main_files: ["main.swift"]
        related_files: ["Package.swift"]
        target_types: ["executable"]
    },
    language: FSharp {
        aliases: ["fsharp", "f#"]
        display_name: "F#"
        extensions: ["fs", "fsx"]
        header_extensions: []
        main_files: ["Program.fs", "main.fsx"]
        related_files: []
        target_types: ["executable"]
    },
    language: JavaScript {
        aliases: ["javascript", "js"]
        display_name: JavaScript
        extensions: ["js", "jsx", "mjs"]
        header_extensions: []
        main_files: ["index.js", "main.js"]
        related_files: ["package.json"]
        target_types: ["executable"]
    },
    language: TypeScript {
        aliases: ["typescript", "ts"]
        display_name: TypeScript
        extensions: ["ts", "tsx"]
        header_extensions: []
        main_files: ["index.ts", "main.ts"]
        related_files: ["package.json", "tsconfig.json"]
        target_types: ["executable"]
    },
    language: Python {
        aliases: ["python", "py"]
        display_name: Python
        extensions: ["py"]
        header_extensions: []
        main_files: ["main.py", "__main__.py"]
        related_files: ["pyproject.toml"]
        target_types: ["executable"]
    }
}