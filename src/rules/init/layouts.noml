ruleset "layouts" {
    layout: src {
        directory: src
        role: source
        priority: 100
    },
    layout: source {
        directory: source
        role: source
        priority: 90
    },
    layout: app {
        directory: app
        role: source
        priority: 80
    },
    layout: lib {
        directory: lib
        role: source
        priority: 70
    },
    layout: include {
        directory: include
        role: include
        priority: 100
    },
    layout: includes {
        directory: includes
        role: include
        priority: 90
    },
    layout: inc {
        directory: inc
        role: include
        priority: 80
    },
    layout: headers {
        directory: headers
        role: include
        priority: 70
    },
    layout: public {
        directory: public
        role: include
        priority: 60
    },
    layout: tests {
        directory: tests
        role: test
        priority: 100
    },
    layout: test {
        directory: test
        role: test
        priority: 90
    },
    layout: spec {
        directory: spec
        role: test
        priority: 80
    },
    layout: examples {
        directory: examples
        role: example
        priority: 70
    }
}