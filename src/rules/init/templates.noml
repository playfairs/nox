ruleset "templates" {
    template: rust_manifest {
        languages: ["Rust"]
        optional: true
        path: "Cargo.toml"
    },
    template: javascript_manifest {
        languages: ["JavaScript", "TypeScript"]
        optional: true
        path: "package.json"
    },
    template: typescript_config {
        languages: ["TypeScript"]
        optional: true
        path: "tsconfig.json"
    },
    template: swift_manifest {
        languages: ["Swift"]
        optional: true
        path: "Package.swift"
    },
    template: python_manifest {
        languages: ["Python"]
        optional: true
        path: "pyproject.toml"
    },
    template: noxfile {
        languages: []
        optional: true
        path: noxfile
    },
    template: flake {
        languages: []
        optional: true
        path: "flake.nix"
    },
    template: readme {
        languages: []
        optional: true
        path: "README.md"
    },
    template: gitignore {
        languages: []
        optional: true
        path: ".gitignore"
    }
}